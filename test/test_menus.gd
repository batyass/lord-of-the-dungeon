extends SceneTree

func _init() -> void:
	print("--- Running Menu Hierarchy & Visual Styling Tests ---")
	
	# Test 1: Parallax Background
	var bg_scene = load("res://scenes/menu_parallax_background.tscn")
	assert(bg_scene != null, "Parallax background scene must load")
	var bg_inst = bg_scene.instantiate()
	assert(bg_inst != null, "Parallax background must instantiate")
	print("[PASS] Test 1: Parallax background loaded successfully.")
	bg_inst.free()
	
	# Test 2: Main Start Menu
	var main_scene = load("res://scenes/main_menu.tscn")
	assert(main_scene != null, "Main menu scene must load")
	var main_inst = main_scene.instantiate()
	assert(main_inst != null, "Main menu must instantiate")
	root.add_child(main_inst)
	
	var title = main_inst.find_child("TitleLabel", true, false)
	assert(title != null, "TitleLabel must exist")
	assert(title.text == "Lord of the Dungeon", "Title must be 'Lord of the Dungeon'")
	
	var btn_play = main_inst.find_child("BtnPlay", true, false)
	var btn_options = main_inst.find_child("BtnOptions", true, false)
	var btn_credits = main_inst.find_child("BtnCredits", true, false)
	var btn_quit = main_inst.find_child("BtnQuit", true, false)
	assert(btn_play != null, "BtnPlay must exist")
	assert(btn_options != null, "BtnOptions must exist")
	assert(btn_credits != null, "BtnCredits must exist")
	assert(btn_credits.visible, "BtnCredits must be visible on Main Menu")
	assert(btn_quit != null, "BtnQuit must exist")
	assert(btn_play.text == "Play", "Play button text must match")
	assert(btn_options.text == "Options", "Options button text must match")
	assert(btn_credits.text == "Credits", "Credits button text must match")
	assert(btn_quit.text == "Quit", "Quit button text must match")
	var main_scene_source := FileAccess.get_file_as_string("res://scenes/main_menu.tscn")
	assert(main_scene_source.contains("from=\"CenterContainer/Panel/VBoxContainer/ButtonBox/BtnCredits\" to=\".\" method=\"_on_credits_pressed\""), "BtnCredits must connect to _on_credits_pressed")
	var main_script = load("res://scenes/main_menu.gd")
	var main_script_source := FileAccess.get_file_as_string("res://scenes/main_menu.gd")
	assert(main_script != null, "Main menu script must load")
	assert(main_script_source.contains("res://scenes/credits_menu.tscn"), "Credits handler must route to credits_menu.tscn")
	print("[PASS] Test 2: Main Start Menu verified with Title 'Lord of the Dungeon', Play, Options, Credits, Quit.")
	main_inst.free()
	
	# Test 3: Difficulty Selection
	var diff_scene = load("res://scenes/difficulty_selection.tscn")
	assert(diff_scene != null, "Difficulty selection scene must load")
	var diff_inst = diff_scene.instantiate()
	assert(diff_inst != null, "Difficulty selection must instantiate")
	root.add_child(diff_inst)
	
	var btn_normal = diff_inst.find_child("BtnNormal", true, false)
	var btn_hard = diff_inst.find_child("BtnHard", true, false)
	var btn_impossible = diff_inst.find_child("BtnImpossible", true, false)
	var btn_back_diff = diff_inst.find_child("BtnBack", true, false)
	assert(btn_normal != null, "BtnNormal must exist")
	assert(btn_hard != null, "BtnHard must exist")
	assert(btn_impossible != null, "BtnImpossible must exist")
	assert(btn_back_diff != null, "BtnBack must exist in Difficulty Selection")
	print("[PASS] Test 3: Difficulty Selection verified with Normal, Hard, Impossible, Back.")
	diff_inst.free()
	
	# Test 4: Credits Menu
	var credits_scene = load("res://scenes/credits_menu.tscn")
	assert(credits_scene != null, "Credits menu scene must load")
	var credits_inst = credits_scene.instantiate()
	assert(credits_inst != null, "Credits menu must instantiate")
	root.add_child(credits_inst)
	var credits_title = credits_inst.find_child("TitleLabel", true, false)
	var btn_credits_back = credits_inst.find_child("BtnBack", true, false)
	assert(credits_title != null, "Credits menu TitleLabel must exist")
	assert(btn_credits_back != null, "Credits menu BtnBack must exist")
	assert(btn_credits_back.text == "Back", "Credits menu return control must be labeled Back")
	var credits_scene_source := FileAccess.get_file_as_string("res://scenes/credits_menu.tscn")
	assert(credits_scene_source.contains("from=\"CenterContainer/Panel/VBoxContainer/ButtonBox/BtnBack\" to=\".\" method=\"_on_back_pressed\""), "Credits menu BtnBack must connect to _on_back_pressed")
	credits_inst.free()
	print("[PASS] Test 4: Credits menu instantiated with connected Back return control.")
	
	# Test 5: Level Selection
	var lvl_scene = load("res://scenes/level_selection.tscn")
	assert(lvl_scene != null, "Level selection scene must load")
	var lvl_inst = lvl_scene.instantiate()
	assert(lvl_inst != null, "Level selection must instantiate")
	root.add_child(lvl_inst)
	
	var btn_lvl1 = lvl_inst.find_child("BtnLevel1", true, false)
	var btn_lvl2 = lvl_inst.find_child("BtnLevel2", true, false)
	var btn_lvl3 = lvl_inst.find_child("BtnLevel3", true, false)
	var btn_back_lvl = lvl_inst.find_child("BtnBack", true, false)
	assert(btn_lvl1 != null, "BtnLevel1 must exist")
	assert(btn_lvl2 != null, "BtnLevel2 must exist")
	assert(btn_lvl3 != null, "BtnLevel3 must exist")
	assert(btn_back_lvl != null, "BtnBack must exist in Level Selection")
	assert(btn_lvl1.text == "SELECT", "Level 1 text must be 'SELECT'")
	assert(btn_lvl2.text == "SELECT", "Level 2 text must be 'SELECT'")
	assert(btn_lvl3.text == "SELECT", "Level 3 text must be 'SELECT'")
	assert(btn_back_lvl.text == "Back", "Back button text must match")
	print("[PASS] Test 4: Level Selection verified with SELECT action buttons and Back.")
	lvl_inst.free()
	
	print("--- All Menu UI & Hierarchy Tests Passed Successfully! ---")
	quit(0)
